@startuml components
!theme plain
title Zenv DMZ CA: Component view (Cargo workspace)

actor "Browser user" as User
actor "API client / CI" as Client
actor "Relying party" as RP
actor "Administrator\n(shell on CA host)" as Admin

package "zenv-cad (daemon binary)" {
  [axum Router\n+ middleware\n(CSP, HSTS, body limit,\ntimeout, tracing)] as Router
  [Web UI\n(static, embedded)] as UI
  [Auth extractors\n(Bearer → Principal)] as Auth
  [Handlers\npki / certs / verify / admin] as Handlers
  [AppState\n(CRL cache, spawn_blocking)] as State
}

package "zenv-ca (admin CLI binary)" {
  [init / token / cert /\ntls / audit commands] as CLI
}

package "zenv-ca-core (library, no I/O)" {
  [hierarchy\n(root, intermediate)] as Hier
  [CertificateAuthority\n(issue, CRL)] as CA
  [IssuancePolicy] as Policy
  [CertProfile] as Profile
  [verify] as Verify
  [export\n(PEM/DER/chain/P12)] as Export
  [keys\n(encrypted PKCS#8)] as Keys
}

package "zenv-ca-store (library, contract)" {
  interface CaStore
  [audit chain · tokens\nrow codec · testkit] as Shared
}
package "zenv-ca-store-sqlite" {
  [SqliteStore] as Sqlite
}
package "zenv-ca-store-postgres" {
  [PostgresStore\n(r2d2 pool, rustls)] as Pg
}

database "SQLite (WAL)\nzenv-ca.db" as DB
database "PostgreSQL\n(shared, HA)" as PGDB
folder "data_dir/ca\nroot.crt, intermediate.crt\n*.key.enc (PBES2)" as Files
folder "data_dir/tls\nserver.chain.pem\nserver.key" as Tls

User --> UI : HTTPS
User --> Router : JSON API
Client --> Router : JSON API
RP --> Router : /pki/*, /verify, /status
Admin --> CLI

Router --> UI
Router --> Handlers
Handlers --> Auth
Handlers --> State
State --> CA
State --> CaStore
Handlers --> Export
Handlers --> Verify
CA --> Policy
CA --> Profile
CA --> Keys
Verify ..> CaStore : Revocations (fail closed)
CLI --> Hier
CLI --> CaStore
CLI --> CA
Sqlite ..|> CaStore
Pg ..|> CaStore
Sqlite ..> Shared
Pg ..> Shared
Sqlite --> DB
Pg --> PGDB
Hier --> Files
CA ..> Files : loaded at start-up
Router ..> Tls : rustls
@enduml
